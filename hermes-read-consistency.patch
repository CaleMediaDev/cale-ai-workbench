diff --git a/tests/tools/test_native_read_consistency.py b/tests/tools/test_native_read_consistency.py
new file mode 100644
--- /dev/null
+++ b/tests/tools/test_native_read_consistency.py
@@ -0,0 +1,33 @@
+"""The native reader must not report a mixed version of a changing file."""
+
+import os
+
+from tools import file_operations
+from tools.file_operations import ShellFileOperations
+
+
+class LocalEnvironment:
+    def __init__(self, cwd):
+        self.cwd = str(cwd)
+
+
+def test_native_read_retries_when_file_changes_during_scan(tmp_path, monkeypatch):
+    path = tmp_path / "changing.txt"
+    path.write_bytes(b"before\n")
+    operations = ShellFileOperations(LocalEnvironment(tmp_path))
+    real_fstat = os.fstat
+    calls = 0
+
+    def changing_fstat(fd):
+        nonlocal calls
+        calls += 1
+        if calls == 2:
+            path.write_bytes(b"after\n")
+        return real_fstat(fd)
+
+    monkeypatch.setattr(file_operations.os, "fstat", changing_fstat)
+    result = operations._read_file_native(str(path), 1, 20)
+
+    assert "changed while being read" in result.error
+    assert result._snapshot is None
+    assert calls == 2
