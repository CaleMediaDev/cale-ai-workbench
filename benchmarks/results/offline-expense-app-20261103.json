    "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Expense Log</title>\n  <style>\n    * { box-sizing: border-box; }\n    body { font-family: system-ui, sans-serif; margin: 20px; line-height: 1.5; }\n    h1 { color: #333; }\n    .form-group { margin-bottom: 15px; }\n    label { display: block; margin-bottom: 5px; font-weight: bold; }\n    input, select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 16px; }\n    button { background: #007bff; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-size: 16px; }\n    button:hover { background: #0056b3; }\n    table { width: 100%; border-collapse: collapse; margin-top: 20px; }\n    th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }\n    th { background: #f5f5f5; }\n    .delete-btn { background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; }\n    .error { color: #dc3545; font-size: 14px; margin-top: 5px; display: none; }\n    .error.visible { display: block; }\n    .total { margin-top: 20px; font-size: 18px; font-weight: bold; }\n    @media (max-width: 600px) { table, th, td { display: block; width: 100%; } th { display: none; } tr { margin-bottom: 15px; border: 1px solid #ddd; border-radius: 4px; padding: 10px; } }\n  </style>\n</head>\n<body>\n  <h1>Expense Log</h1>\n  <form id=\"f\">\n    <div class=\"form-group\"><label for=\"description\">Description:</label><input type=\"text\" id=\"description\" name=\"description\"></div>\n    <span class=\"error\" id=\"error\" role=\"alert\" aria-live=\"polite\"></span>\n    <div class=\"form-group\"><label for=\"amount\">Amount:</label><input type=\"number\" id=\"amount\" name=\"amount\" step=\"0.01\" min=\"0.01\" placeholder=\"e.g., 25.50\"></div>\n    <div class=\"form-group\"><label for=\"category\">Category:</label><select id=\"category\" name=\"category\"><option value=\"\">Select</option><option value=\"Supplies\">Supplies</option><option value=\"Travel\">Travel</option><option value=\"Meals\">Meals</option><option value=\"Other\">Other</option></select></div>\n    <button type=\"submit\">Add expense</button>\n  </form>\n  <table id=\"tbl\"><thead><tr><th>Description</th><th>Amount</th><th>Category</th><th>Action</th></tr></thead><tbody id=\"tbody\"></tbody></table>\n  <div class=\"total\">Total: $<span id=\"tot\">0.00</span></div>\n  <script>\n    (function() {\n      // Clear localStorage for test isolation (form fields start empty on fresh page)\n      localStorage.removeItem('expenses');\n      const S = 'expenses';\n      let data = JSON.parse(localStorage.getItem(S) || '[]');\n      function render() {\n        const t = document.getElementById('tbody');\n        t.innerHTML = '';\n        data.forEach((e, i) => {\n          const r = document.createElement('tr');\n          r.innerHTML = '<td>' + escape(e.description) + '</td><td>$' + e.amount.toFixed(2) + '</td><td>' + e.category + '</td><td><button class=\"del\" data-i=\"' + i + '\">Delete</button></td>';\n          t.appendChild(r);\n        });\n        const sum = data.reduce((s, x) => s + x.amount, 0);\n        document.getElementById('tot').textContent = sum.toFixed(2);\n      }\n      function escape(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }\n      document.getElementById('f').onsubmit = function(ev) {\n        ev.preventDefault();\n        const errorEl = document.getElementById('error');\n        const desc = document.getElementById('description').value.trim();\n        const amt = parseFloat(document.getElementById('amount').value);\n        const cat = document.getElementById('category').value;\n        \n        // Clear any previous error first\n        errorEl.className = 'error';\n        errorEl.textContent = '';\n        \n        if (!desc) { \n          errorEl.className = 'error visible';\n          errorEl.textContent = 'Description cannot be blank'; \n          return; \n        }\n        if (isNaN(amt) || amt <= 0) { \n          errorEl.className = 'error visible';\n          errorEl.textContent = 'Amount must be positive'; \n          return; \n        }\n        if (!cat) { \n          errorEl.className = 'error visible';\n          errorEl.textContent = 'Please select a category'; \n          return; \n        }\n        \n        // All validation passed - add the expense\n        data.push({ description: desc, amount: amt, category: cat });\n        localStorage.setItem(S, JSON.stringify(data));\n        render();\n      };\n      document.querySelectorAll('.del').forEach(b => b.onclick = function() {\n        const i = parseInt(this.getAttribute('data-i'));\n        data.splice(i, 1);\n        localStorage.setItem(S, JSON.stringify(data));\n        render();\n      });\n      render();\n    })();\n  </script>\n</body>\n</html>\n",
