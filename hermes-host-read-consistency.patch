diff --git a/tests/tools/test_host_read_consistency.py b/tests/tools/test_host_read_consistency.py
new file mode 100644
--- /dev/null
+++ b/tests/tools/test_host_read_consistency.py
@@ -0,0 +1,22 @@
+"""A changing host file must yield a retry, not a mixed read result."""
+
+import json
+
+from tools import file_tools
+from tools.file_operations_common import ReadResult
+
+
+def test_host_read_retries_after_concurrent_change(tmp_path, monkeypatch):
+    path = tmp_path / "changing.txt"
+    path.write_text("before\n", encoding="utf-8")
+
+    class ChangingFileOps:
+        def read_file(self, _path, _offset, _limit):
+            path.write_text("after\n", encoding="utf-8")
+            return ReadResult(content="before\n", total_lines=1, file_size=7)
+
+    monkeypatch.setattr(file_tools, "_get_file_ops", lambda _task_id: ChangingFileOps())
+    result = json.loads(file_tools.read_file_tool(str(path), task_id="changing-host-file"))
+
+    assert "changed while being read" in result["error"]
+    assert "before" not in str(result)
